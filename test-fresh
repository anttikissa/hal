#!/usr/bin/env bash
set -euo pipefail

# Recreate ~/.hal-fresh as a brand-new-user checkout of this repo, so the intro
# and installer can be tried exactly as a newcomer would see them.
#
# The target is hardcoded and takes no arguments: this script runs `rm -rf` on
# it, so the path you delete must be the path you can read right here.
fresh_dir="$HOME/.hal-fresh"

hal_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

rm -rf "$HOME/.hal-fresh"
git clone --quiet "$hal_dir" "$fresh_dir"

echo "Fresh checkout at $fresh_dir ($(git -C "$fresh_dir" log --oneline -1))"
echo
echo "Run it with:"
echo "  cd $fresh_dir && ./run -l"
