#!/usr/bin/env bash
# Hal installer (task: tsk show for "install"). Makes sure Bun is there,
# installs dependencies, links ~/.local/bin/hal to ./run and puts
# ~/.local/bin on the PATH. Safe to run again: it only does what is
# missing. -y answers yes to the one question.
set -euo pipefail

hal_dir="$(cd "$(dirname "$0")" && pwd)"
bin_dir="$HOME/.local/bin"
yes=""
for arg in "$@"; do
	case "$arg" in
		-y) yes=1 ;;
		*) echo "unknown option: $arg (only -y)" >&2; exit 1 ;;
	esac
done

pretty() { echo "${1/#$HOME/~}"; }

# The shell config that sets PATH for this user's login shell.
case "$(basename "${SHELL:-/bin/sh}")" in
	zsh) rc="$HOME/.zshenv"; line='export PATH="$HOME/.local/bin:$PATH"' ;;
	bash) [ "$(uname -s)" = Darwin ] && rc="$HOME/.bash_profile" || rc="$HOME/.bashrc"; line='export PATH="$HOME/.local/bin:$PATH"' ;;
	fish) rc="$HOME/.config/fish/config.fish"; line='fish_add_path $HOME/.local/bin' ;;
	*) rc=""; line='export PATH="$HOME/.local/bin:$PATH"' ;;
esac

need_bun="" need_deps="" need_link="" need_path=""
command -v bun >/dev/null || [ -x "$HOME/.bun/bin/bun" ] || need_bun=1
[ -d "$hal_dir/node_modules" ] || need_deps=1
[ "$(readlink "$bin_dir/hal" 2>/dev/null)" = "$hal_dir/run" ] || need_link=1
case ":$PATH:" in *":$bin_dir:"*) ;; *) need_path=1 ;; esac

mark() { [ -n "$1" ] && echo "[ ] $2" || echo "[x] $2"; }
echo
mark "$need_bun" "bun"
mark "$need_deps" "bun install"
mark "$need_link" "$(pretty "$bin_dir")/hal -> $(pretty "$hal_dir")/run"
mark "$need_path" "$(pretty "$bin_dir") in PATH"
echo

if [ -z "$need_bun$need_deps$need_link$need_path" ]; then
	echo "Everything in order. Start with: hal"
	exit 0
fi

if [ -z "$yes" ]; then
	printf "Set up Hal? [Y/n] "
	read -r answer
	case "$answer" in ""|[Yy]*) ;; *) exit 0 ;; esac
fi

if [ -n "$need_bun" ]; then
	echo "Installing bun..."
	curl -fsSL https://bun.sh/install | bash
fi
export PATH="$HOME/.bun/bin:$PATH"

if [ -n "$need_deps" ]; then
	bun install --cwd "$hal_dir"
fi

if [ -n "$need_link" ]; then
	mkdir -p "$bin_dir"
	ln -sfn "$hal_dir/run" "$bin_dir/hal"
	echo "Linked $(pretty "$bin_dir")/hal"
fi

if [ -n "$need_path" ]; then
	if [ -z "$rc" ]; then
		echo "Add this to your shell config: $line"
	elif [ -f "$rc" ] && grep -v '^#' "$rc" | grep -qF '.local/bin'; then
		: # the config already adds it; only this shell lacks it
	else
		mkdir -p "$(dirname "$rc")"
		printf '\n# Added by hal installer\n%s\n' "$line" >> "$rc"
		echo "Added $(pretty "$bin_dir") to PATH in $(pretty "$rc")"
	fi
	echo
	echo "Open a new shell, then start with: hal"
else
	echo
	echo "Start with: hal"
fi
