					kind: 'compatible',
					target: 'host/plugin-files',
					description: 'Add optional within, transform and changed hook points for EDIT and recorded Bash changes.'
				},
				{
					kind: 'breaking',
					target: 'host/plugins.broken',
					description: 'Failed plugin files remain at their original paths and unchanged failed bytes are not retried on events',
					port: 'Fix the original file; do not look for a .broken rename.'
				}
			]
		},
		{
			version: 3,
