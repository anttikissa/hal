					kind: 'breaking',
					target: 'host/plugins.state.watcher',
					description: 'Replaced by per-directory state and startup notification state',
					port: 'Use state.directories for lifetimes and state.started for notices'
				},
				{
					kind: 'breaking',
					target: 'host/plugins.Loaded.hooks.file',
					description: 'Stores the full path; equal basenames compose by path then sequence',
