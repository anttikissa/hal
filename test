#!/usr/bin/env bash
# Runs tests, typecheck and lint; fails if any of them fails.
cd "$(dirname "$0")"
status=0
# Tests never use real API keys from the environment.
unset ANTHROPIC_API_KEY OPENROUTER_API_KEY OPENCODE_API_KEY OPENAI_API_KEY
# Inside GNU screen the terminal client is monochrome; tests expect colour.
unset STY
if [[ $TERM == screen* ]]; then export TERM=xterm-256color; fi
bun test src || status=1
./node_modules/.bin/tsc --noEmit || status=1
./node_modules/.bin/oxlint --deny-warnings src || status=1
# The optional, gitignored local.ts is typechecked by tsc above (it sits in
# the project root); here it is also imported in its own process, since
# ordinary tests never load it.
if [ -f local.ts ]; then
	bun -e "await import('./local.ts')" || status=1
fi
# Plugins (task an) are typechecked by tsc too; importing one must do
# nothing but define it, so each is also imported on its own.
for f in plugins/*.ts; do
	bun -e "await import('./$f')" || status=1
done
exit $status
