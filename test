#!/usr/bin/env bash
# Runs tests, typecheck and lint; fails if any of them fails.
cd "$(dirname "$0")"
status=0
# Tests never use real API keys from the environment.
unset ANTHROPIC_API_KEY OPENROUTER_API_KEY OPENCODE_API_KEY OPENAI_API_KEY
# Inside GNU screen the terminal client is monochrome; tests expect color.
unset STY
if [[ $TERM == screen* ]]; then export TERM=xterm-256color; fi
# Hosts under test are killed at any moment; a git call they make must
# never take a lock, or a stale .git/index.lock breaks the next commit.
# ./test [filename-pattern ...]: normal tests; patterns never match test names.
# ./test-expensive [filename-pattern ...]: web tests, including Chromium.
suite=normal
if [ "${1-}" = --web ]; then suite=web; shift; fi
paths=()
roots=(src)
if [ -d extras ]; then roots+=(extras); fi
while IFS= read -r -d '' path; do
	case "$path" in
		src/web/*|src/host/web*.test.ts) kind=web ;;
		*) kind=normal ;;
	esac
	if [ "$kind" != "$suite" ]; then
		for pattern in "$@"; do
			pattern=${pattern#"$PWD/"}; pattern=${pattern#./}
			if [ "$pattern" = "$path" ]; then
				echo "./test: $path belongs to the $kind suite; use $([ "$kind" = web ] && echo ./test-expensive || echo ./test)" >&2
				exit 1
			fi
		done
		continue
	fi
	match=0
	if [ $# -eq 0 ]; then match=1; fi
	for pattern in "$@"; do
		pattern=${pattern#"$PWD/"}; pattern=${pattern#./}; pattern=${pattern%/}
		if [[ $path == $pattern || ${path##*/} == $pattern || $path == *"$pattern"* ]]; then match=1; fi
	done
	if [ "$match" -eq 1 ]; then paths+=("./$path"); fi
done < <(find "${roots[@]}" -type f -name '*.test.ts' -print0)
if [ ${#paths[@]} -eq 0 ]; then
	echo "./test: no $suite test filenames match: $*" >&2
	exit 1
fi
if [ $# -gt 0 ] || [ "$suite" = web ]; then exec bun test "${paths[@]}"; fi
lock="$(git rev-parse --git-path index.lock 2>/dev/null)"
had_lock=$([ -e "$lock" ] && echo 1)
bun test "${paths[@]}" || status=1
if [ -z "$had_lock" ] && [ -e "$lock" ]; then
	echo "./test: the tests left $lock behind (a host git call takes a lock)" >&2
	status=1
fi
./node_modules/.bin/tsc --noEmit || status=1
./node_modules/.bin/oxlint --deny-warnings src || status=1
# The optional, gitignored local.ts is typechecked by tsc above (it sits in
# the project root); here it is also imported in its own process, since
# ordinary tests never load it.
if [ -f local.ts ]; then
	bun -e "await import('./local.ts')" || status=1
fi
# Plugins (task an) are typechecked by tsc too; importing one must do
# nothing but define it, so each is also imported on its own.
for f in plugins/*.ts; do
	bun -e "await import('./$f')" || status=1
done
# Task 5cz: the scroll drift probe is temporary. From its due date,
# remind every run to delete it; this warns and never fails the run.
# Deleting src/web/drift.ts silences it; 5cz deletes these lines too.
if [ -f src/web/drift.ts ] && [[ $(date +%F) > 2026-10-28 ]]; then
	echo "./test: warning: task 5cz is due: remove the scroll drift probe" >&2
fi
exit $status
