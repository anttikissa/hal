{
	title: 'Keep streamed Markdown lines separated on Safari',
	spec: 'Web Markdown preserves each source line as a separate block, including bold standalone titles followed by prose. Only the final source line is inline while a stream cursor or interruption marker follows it. The renderer assigns this inline-tail state explicitly rather than relying on CSS sibling :has invalidation as streaming appends lines. Terminal line layout stays unchanged.',
	status: 'done',
