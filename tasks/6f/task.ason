{
	title: 'Approval for dangerous tool calls',
	description: 'Before running a tool call, the host checks it against patterns for dangerous commands (rm -rf and friends; not plain rm -f, which models overuse harmlessly). A match asks a durable y/N question showing the call with the offending part highlighted; No returns an error result to the model, Yes runs it. One setting switches the policy: strict, loose or yolo (never ask). See tasks/w4/forms.md (Approval).',
	status: 'planned',
	needs: ['w4', '1r']
}
