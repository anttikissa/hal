#!/bin/bash
# usage: scripts/sloc <git-dir> <rev>  -> non-blank, non-comment lines in non-test .ts/.tsx files
cd "$1"
git ls-tree -r --name-only "$2" | grep -E '\.(ts|tsx)$' | grep -vE '(\.test\.tsx?$|/tests?/|test-|\.d\.ts$|^tasks/|^docs/)' | while read f; do git show "$2:$f"; echo; done |
awk '
	{ line=$0 }
	inblock { if (line ~ /\*\//) { inblock=0; sub(/.*\*\//, "", line) } else next }
	{ gsub(/^[ \t]+|[ \t]+$/, "", line) }
	line ~ /^\/\*/ { if (line !~ /\*\//) inblock=1; next }
	line == "" || line ~ /^\/\// { next }
	{ n++ }
	END { print n+0 }'
