#!/usr/bin/env bash
# Download local web font faces and licenses without storing binaries in Git.
set -eu
cd "$(dirname "$0")/.."
mkdir -p src/web/fonts
if [ "$#" -eq 0 ]; then set -- Light Medium SourceCodePro-LightItalic SourceCodePro-MediumItalic; fi
for face in "$@"; do
  case "$face" in
    Light|Medium)
      file="IBMPlexMono-$face.woff2"
      url="https://raw.githubusercontent.com/IBM/plex/master/packages/plex-mono/fonts/complete/woff2/$file"
      license='https://raw.githubusercontent.com/IBM/plex/master/LICENSE.txt' ;;
    JetBrainsMono-LightItalic)
      file="$face.woff2"
      url="https://raw.githubusercontent.com/JetBrains/JetBrainsMono/master/fonts/webfonts/$file"
      license='https://raw.githubusercontent.com/JetBrains/JetBrainsMono/master/OFL.txt' ;;
    SourceCodePro-LightItalic|SourceCodePro-MediumItalic)
      file="$face.woff2"
      url="https://raw.githubusercontent.com/adobe-fonts/source-code-pro/release/WOFF2/TTF/${face%Italic}It.ttf.woff2"
      license='https://raw.githubusercontent.com/adobe-fonts/source-code-pro/release/LICENSE.md' ;;
    RobotoMono-Italic)
      file="$face.ttf"
      url='https://raw.githubusercontent.com/google/fonts/main/ofl/robotomono/RobotoMono-Italic%5Bwght%5D.ttf'
      license='https://raw.githubusercontent.com/google/fonts/main/ofl/robotomono/OFL.txt' ;;
    VictorMono-Italic|CascadiaMono-Italic|FragmentMono-Italic|Cousine-Italic)
      file="$face.ttf"
      family=$(printf '%s' "${face%-Italic}" | tr '[:upper:]' '[:lower:]')
      case "$face" in VictorMono-*|CascadiaMono-*) source="$face%5Bwght%5D.ttf" ;; *) source="$file" ;; esac
      url="https://raw.githubusercontent.com/google/fonts/main/ofl/$family/$source"
      license="https://raw.githubusercontent.com/google/fonts/main/ofl/$family/OFL.txt" ;;
    IntelOneMono-Italic|IntelOneMono-LightItalic|IntelOneMono-MediumItalic|IntelOneMono-BoldItalic)
      file="$face.woff2"
      url="https://raw.githubusercontent.com/intel/intel-one-mono/main/fonts/woff2/$file"
      license='https://raw.githubusercontent.com/intel/intel-one-mono/main/fonts/woff2/OFL.txt' ;;
    *) printf 'Unknown font face: %s\n' "$face" >&2; exit 1 ;;
  esac
  target="src/web/fonts/$file"
  trap 'rm -f "$target.download"' EXIT
  curl --fail --location --output "$target.LICENSE" "$license"
  curl --fail --location --output "$target.download" "$url"
  mv "$target.download" "$target"
done
